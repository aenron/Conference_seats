# 人员视图：与 llm2word 分项配置完全一致。
# 可选：若已配置完整 SQLAlchemy URL，可设置 PERSONNEL_DATABASE_URL，并省略下方分项连接信息。
PERSONNEL_DATABASE_URL=
PERSONNEL_DB_TYPE=oracle
PERSONNEL_DB_HOST=172.16.128.73
PERSONNEL_DB_PORT=1521
PERSONNEL_DB_USER=Z_Z_RVMSJBVK
PERSONNEL_DB_PASSWORD=
PERSONNEL_DB_SERVICE_NAME=ORCL
PERSONNEL_DB_NAME=
PERSONNEL_DB_SCHEMA=SHAREDB
PERSONNEL_DB_VIEW=V_ZK_ZGXX
PERSONNEL_COL_EMPLOYEE_ID=GH
PERSONNEL_COL_NAME=XM
PERSONNEL_COL_DEPARTMENT=SZBM
PERSONNEL_COL_ORGANIZATION=SZDW
PERSONNEL_COL_PROFESSIONAL_TITLE=PRZYJSZW
PERSONNEL_COL_POST_LEVEL=PRGLGWDJ
PERSONNEL_COL_ADMINISTRATIVE_TITLE=XZZWMC

# 下载地址对外可访问时请改为实际域名
# 容器暴露的宿主机端口，docker compose 默认映射为 8100:8100
MCP_PORT=8100

# 必须为智能体/浏览器可访问的外部地址；部署到服务器时改为实际 IP 或域名。
MCP_DOWNLOAD_BASE_URL=http://127.0.0.1:8100

# FastMCP SSE 的 Host/Origin 白名单。公网或局域网部署时须填入实际访问地址。
MCP_ALLOWED_HOSTS=127.0.0.1:8100,localhost:8100,168.8.6.168:8100
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8100,http://localhost:8100,http://168.8.6.168:8100
