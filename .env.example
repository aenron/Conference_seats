# 下载地址对外可访问时请改为实际域名
# 容器暴露的宿主机端口，docker compose 默认映射为 8100:8100
MCP_PORT=8100

# 必须为智能体/浏览器可访问的外部地址；部署到服务器时改为实际 IP 或域名。
MCP_DOWNLOAD_BASE_URL=http://127.0.0.1:8100
