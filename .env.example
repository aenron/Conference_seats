PERSONNEL_DATABASE_URL=
PERSONNEL_DB_SCHEMA=
PERSONNEL_DB_VIEW=
PERSONNEL_COL_EMPLOYEE_ID=GH
PERSONNEL_COL_NAME=XM
PERSONNEL_COL_DEPARTMENT=SZBM
PERSONNEL_COL_ORGANIZATION=SZDW
PERSONNEL_COL_PROFESSIONAL_TITLE=PRZYJSZW
